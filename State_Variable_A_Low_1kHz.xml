<?xml version="1.0" encoding="UTF-8"?>
<PointToPointCircuit>
    <Name>State_Variable_A_Low_1kHz</Name>
    <Category>Lite</Category>
    <Settings>
        <numNodes>6</numNodes>
        <hasDCBlocker>false</hasDCBlocker>
    </Settings>
    <Elements>
        <VoltageInput>
            <node1>1</node1>
            <node2>0</node2>
        </VoltageInput>
        <VoltageOutput>
            <node1>6</node1>
            <node2>0</node2>
        </VoltageOutput>
        <Rs>
            <Resistor>
                <value>10000</value>
                <node1>1</node1>
                <node2>2</node2>
            </Resistor>
            <Resistor>
                <value>10000</value>
                <node1>3</node1>
                <node2>0</node2>
            </Resistor>
            <Resistor>
                <value>10000</value>
                <node1>3</node1>
                <node2>4</node2>
            </Resistor>
            <Resistor>
                <value>10000</value>
                <node1>2</node1>
                <node2>6</node2>
            </Resistor>
            <Resistor>
                <value>1590</value>
                <node1>4</node1>
                <node2>5</node2>
            </Resistor>
        </Rs>
        <Cs>
            <Capacitor>
                <value>1e-07</value>
                <node1>5</node1>
                <node2>6</node2>
            </Capacitor>
        </Cs>
        <OPAmps>
            <OPAmp>
                <nonInvertingNode>2</nonInvertingNode>
                <invertingNode>3</invertingNode>
                <outputNode>4</outputNode>
            </OPAmp>
            <OPAmp>
                <nonInvertingNode>0</nonInvertingNode>
                <invertingNode>5</invertingNode>
                <outputNode>6</outputNode>
            </OPAmp>
        </OPAmps>
    </Elements>
</PointToPointCircuit>
